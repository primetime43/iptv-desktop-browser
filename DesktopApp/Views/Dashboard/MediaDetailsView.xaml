<UserControl x:Class="DesktopApp.Views.Dashboard.MediaDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopApp.ViewModels"
             xmlns:models="clr-namespace:DesktopApp.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/iptv-desktop-browser;component/Controls/CatalogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <Style x:Key="DetailLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#8BA1B9" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="DetailValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#FFDDE6F2" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <DataTemplate DataType="{x:Type vm:MediaSummaryRow}">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#FFDDE6F2" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding Year}" FontSize="12" Foreground="#9DB2C7" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="#9DB2C7" Margin="0,0,16,0" />
                        <TextBlock Text="⭐" Foreground="#FFD700" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Rating}" FontSize="12" Foreground="#9DB2C7" />
                    </WrapPanel>
                    <TextBlock Text="Genre:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Genre}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="Cast:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Cast}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="Director:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Director}" Style="{StaticResource DetailValue}" />
                    <TextBlock Text="Plot:" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Plot}" Style="{StaticResource DetailValue}" />
                    <Button Content="▶ Play" Background="#28A745" Foreground="White" Padding="12,8"
                            Visibility="{Binding IsMovie, Converter={StaticResource BooleanVisibility}}"
                            Command="{Binding DataContext.PlayMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="Quality…" Margin="0,8,0,0" Padding="12,6"
                            Visibility="{Binding IsMovie, Converter={StaticResource BooleanVisibility}}"
                            Command="{Binding DataContext.ChooseMovieQualityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SeasonHeaderRow}">
                <Border Background="#223247" CornerRadius="4" Margin="16,4,16,2" Padding="8,4">
                    <TextBlock Text="{Binding Title}" Foreground="#DDE6F2" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:EpisodeContent}">
                <Grid Margin="24,1,16,1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="{Binding DisplayTitle}" Padding="8,4" Background="Transparent"
                        Foreground="#9DB2C7" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="11" Cursor="Hand"
                        Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding DisplayTitle}" />
                    <Button Grid.Column="1" Content="Quality…" Padding="6,4" Margin="4,0,0,0"
                            Command="{Binding DataContext.ChooseEpisodeQualityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Choose the stream quality before playback"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Margin="16,50,16,16" VerticalAlignment="Top"
                    Visibility="{Binding HasPlaceholder, Converter={StaticResource BooleanVisibility}}">
            <TextBlock x:Name="PlaceholderText" Text="{Binding Placeholder}" FontSize="14" Foreground="#8BA1B9" TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="RetryButton" Content="Retry" Command="{Binding RetryCommand}" Margin="0,12,0,0" Padding="12,6"
                    HorizontalAlignment="Center" Visibility="{Binding CanRetry, Converter={StaticResource BooleanVisibility}}" />
        </StackPanel>
        <ItemsControl x:Name="DetailsList" ItemsSource="{Binding Rows}" Style="{StaticResource CatalogListStyle}"
                      Visibility="{Binding HasDetails, Converter={StaticResource BooleanVisibility}}" />
    </Grid>
</UserControl>
