<Window x:Class="DesktopApp.Views.Dashboard.SeriesRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="560" Height="660" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#0D1117" Foreground="#DDE6F2">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Text="Channel" Margin="0,0,0,6"/>
                <ComboBox x:Name="ChannelBox" ItemsSource="{Binding Channels}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedChannel}" IsEnabled="{Binding CanChangeChannel}" Margin="0,0,0,16"/>
                <TextBlock Text="Show name" Margin="0,0,0,6"/>
                <ComboBox x:Name="ShowBox" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Titles}"
                          Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding GuideStatus}" TextWrapping="Wrap" Foreground="#9CAEC4"/>
                <Button Content="Retry guide" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" Padding="10,5"/>
                <TextBlock Text="{Binding NextAiring}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="Title match mode" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding MatchModes}" SelectedItem="{Binding MatchMode}" Margin="0,0,0,16"/>
                <CheckBox Content="Only record new episodes" IsChecked="{Binding OnlyNewEpisodes}" Foreground="#DDE6F2" Margin="0,0,0,16"/>
                <TextBlock Text="Minutes before the program starts" Margin="0,0,0,6"/>
                <TextBox Text="{Binding PreBuffer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                <TextBlock Text="Minutes after the program ends" Margin="0,0,0,6"/>
                <TextBox Text="{Binding PostBuffer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                <TextBlock Text="Changes apply to episodes scheduled from now on. Existing scheduled recordings keep their current settings."
                           Foreground="#9CAEC4" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#F88166" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="View schedule" Command="{Binding PreviewCommand}" Padding="12,8" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Padding="12,8" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Padding="12,8" Background="#28A745" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
