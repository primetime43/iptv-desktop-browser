<UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopApp.Views.Dashboard.SchedulerPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Recording Scheduler" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,16" />

                        <!-- Main Content -->
                        <TabControl Style="{StaticResource SchedulerTabControlStyle}">
                            <!-- Schedule New Recording Tab -->
                            <TabItem Style="{StaticResource SchedulerTabItemStyle}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                        <TextBlock Text="Schedule Recording" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                                    <StackPanel>
                                        <!-- Instructions -->
                                        <Border Background="#161B22" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="►" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="How to Schedule a Recording" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Choose how to schedule your recording using the options below. You can either select a program from the TV guide or set custom start/end times." Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Recording Type Selection -->
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="❶" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="Recording Type" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <RadioButton x:Name="EpgRadio" Foreground="#9DB2C7" Margin="0,0,0,12" IsChecked="True" Checked="RecordingType_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="◆" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#28A745" />
                                                        <StackPanel>
                                                            <TextBlock Text="From TV Guide (EPG)" FontWeight="SemiBold" Foreground="#DDE6F2" />
                                                            <TextBlock Text="Select a show from the program guide" FontSize="11" Foreground="#9DB2C7" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="CustomRadio" Foreground="#9DB2C7" Checked="RecordingType_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="◇" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FFC107" />
                                                        <StackPanel>
                                                            <TextBlock Text="Custom Time Range" FontWeight="SemiBold" Foreground="#DDE6F2" />
                                                            <TextBlock Text="Set your own start and end times" FontSize="11" Foreground="#9DB2C7" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recording Options -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- EPG-based Recording Panel -->
                                            <Border x:Name="EpgPanel" Grid.Column="0" Style="{StaticResource CardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="❷" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                        <TextBlock Text="Select from TV Guide" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock Text="1. Choose a channel:" Foreground="#9DB2C7" Margin="0,0,0,8" />
                                                    <ComboBox x:Name="ChannelCombo" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ChannelCombo_SelectionChanged" />

                                                    <TextBlock Text="2. Pick a show to record:" Foreground="#9DB2C7" Margin="0,0,0,8" />
                                                    <Border Background="#1A2332" BorderBrush="#3B4A5C" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock x:Name="ProgramTimeText" Text="Hover over a show to see air time" Foreground="#9DB2C7" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ComboBox x:Name="ProgramCombo" Margin="0,0,0,8" SelectionChanged="ProgramCombo_SelectionChanged" PreviewMouseMove="ProgramCombo_PreviewMouseMove">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem">
                                                                <EventSetter Event="MouseEnter" Handler="ProgramComboItem_MouseEnter" />
                                                                <EventSetter Event="MouseMove" Handler="ProgramComboItem_MouseMove" />
                                                                <EventSetter Event="MouseLeave" Handler="ProgramComboItem_MouseLeave" />
                                                                <Setter Property="ToolTip">
                                                                    <Setter.Value>
                                                                        <ToolTip>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" Margin="0,0,0,4" />
                                                                                <TextBlock>
                                                                                    <Run Text="📅 " FontSize="12" />
                                                                                    <Run Text="{Binding StartTimeLocal, Mode=OneWay, StringFormat='ddd, MMM dd yyyy'}" FontWeight="SemiBold" />
                                                                                </TextBlock>
                                                                                <TextBlock>
                                                                                    <Run Text="🕐 " FontSize="12" />
                                                                                    <Run Text="{Binding TimeRangeLocal, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Custom Time Recording Panel -->
                                            <Border x:Name="CustomPanel" Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="False">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="❷" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                        <TextBlock Text="Set Custom Times" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1. Channel:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CustomChannelCombo" Margin="0,0,0,8" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CustomChannelCombo_SelectionChanged" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Date:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="StartDatePicker" Margin="0,0,0,8" SelectedDateChanged="CustomTime_Changed" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Start:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                                            <TextBox x:Name="StartTimeBox" Text="20:00" ToolTip="Format: HH:mm (e.g., 20:00 for 8:00 PM)" TextChanged="CustomTime_Changed" />
                                                            <TextBlock Text="Format: HH:mm (20:00)" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=StartTimeBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="4. End:" Foreground="#9DB2C7" Margin="0,0,12,0" />
                                                        <Grid Grid.Row="3" Grid.Column="1">
                                                            <TextBox x:Name="EndTimeBox" Text="21:00" ToolTip="Format: HH:mm (e.g., 21:00 for 9:00 PM)" TextChanged="CustomTime_Changed" />
                                                            <TextBlock Text="Format: HH:mm (21:00)" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=EndTimeBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Recording Details -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="❸" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="Recording Settings" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                    <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                                        <TextBox x:Name="TitleBox" />
                                                        <TextBlock Text="Recording title" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pre-buffer (min):" Foreground="#9DB2C7" Margin="0,0,12,8" ToolTip="Minutes to start recording before the scheduled time" />
                                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                                                        <TextBox x:Name="PreBufferBox" Text="2" ToolTip="Start recording this many minutes early" />
                                                        <TextBlock Text="2" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PreBufferBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Post-buffer (min):" Foreground="#9DB2C7" Margin="0,0,12,8" ToolTip="Minutes to continue recording after the scheduled end time" />
                                                    <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                                                        <TextBox x:Name="PostBufferBox" Text="5" ToolTip="Continue recording this many minutes past the end time" />
                                                        <TextBlock Text="5" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PostBufferBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output File:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="OutputFileBox" IsReadOnly="True" Margin="0,0,12,8" />
                                                    <Button Grid.Row="2" Grid.Column="3" Content="Browse..." Background="#347DFF" Foreground="White" BorderThickness="0" Margin="0,0,0,8" Click="BrowseOutput_Click" />

                                                    <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="Schedule Recording" Background="#28A745" Foreground="White" BorderThickness="0" Padding="24,12" Margin="0,16,0,0" HorizontalAlignment="Center" Click="ScheduleRecording_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Scheduled Recordings Tab -->
                            <TabItem Style="{StaticResource SchedulerTabItemStyle}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#DC3545" />
                                        <TextBlock Text="Scheduled Recordings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                                    <StackPanel>
                                        <!-- Info Section -->
                                        <Border Background="#161B22" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="►" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#17A2B8" />
                                                    <TextBlock Text="Recording Management" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="View and manage your scheduled recordings. The app automatically checks for recordings to start every 30 seconds." Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Toolbar -->
                                        <Border Background="#223247" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Background="#347DFF" Foreground="White" BorderThickness="0" Padding="16,8" Margin="0,0,12,0" Click="RefreshScheduled_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↻" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                                        <TextBlock Text="Refresh List" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Background="#DC3545" Foreground="White" BorderThickness="0" Padding="16,8" Margin="0,0,12,0" Click="DeleteCompleted_Click" ToolTip="Remove all completed, failed, and cancelled recordings from the list">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✖" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                                        <TextBlock Text="Delete Completed" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Background="#28A745" Foreground="White" BorderThickness="0" Padding="16,8" Click="OpenRecordingFolder_Click" ToolTip="Open the directory where recordings are saved">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📂" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
                                                        <TextBlock Text="Open Output Folder" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Scheduled Recordings List -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <DataGrid x:Name="ScheduledGrid" AutoGenerateColumns="False" Background="Transparent" Foreground="#DDE6F2" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent" AlternatingRowBackground="#182433" BorderThickness="0" CanUserAddRows="False">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#223247" />
                                                        <Setter Property="Foreground" Value="#DDE6F2" />
                                                        <Setter Property="BorderBrush" Value="#30363D" />
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="120" />
                                                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeLocal}" Width="140" />
                                                    <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeLocal}" Width="140" />
                                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80" />
                                                    <DataGridTemplateColumn Header="Status" Width="100">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding StatusText}" ToolTip="{Binding FailureReason}" ToolTipService.ShowDuration="30000" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="Props" Background="#28A745" BorderThickness="0" Padding="8,4" Margin="0,0,4,0" FontSize="9" ToolTip="Show recording properties" Click="PropertiesRecording_Click" />
                                                                    <Button Content="Edit" Background="#6C757D" BorderThickness="0" Padding="8,4" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}" FontSize="9" Click="EditRecording_Click" />
                                                                    <Button Content="Cancel" Background="#DC3545" BorderThickness="0" Padding="8,4" FontSize="9" IsEnabled="{Binding CanCancel}" Click="CancelRecording_Click" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Series Recordings Tab -->
                            <TabItem Style="{StaticResource SchedulerTabItemStyle}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FFC107" />
                                        <TextBlock Text="Series Recordings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                                    <StackPanel>
                                        <!-- Info Section -->
                                        <Border Background="#161B22" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="►" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FFC107" />
                                                    <TextBlock Text="Automatic Series Recording" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Set up rules to automatically record new episodes of your favorite shows. The system will monitor EPG data and schedule recordings when matching programs are detected." Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Add New Series Recording Button -->
                                        <Border Background="#223247" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <Button Background="#28A745" Foreground="White" BorderThickness="0" Padding="16,10" Click="AddSeriesRecording_Click" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="+" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" />
                                                    <TextBlock Text="Add Series Recording" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Border>

                                        <!-- Series Recordings List -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <DataGrid x:Name="SeriesGrid" AutoGenerateColumns="False" Background="Transparent" Foreground="#DDE6F2" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowBackground="Transparent" AlternatingRowBackground="#182433" BorderThickness="0" CanUserAddRows="False">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#223247" />
                                                        <Setter Property="Foreground" Value="#DDE6F2" />
                                                        <Setter Property="BorderBrush" Value="#30363D" />
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Series Name" Binding="{Binding SeriesName}" Width="*" />
                                                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelName}" Width="140" />
                                                    <DataGridTextColumn Header="Next Recording" Binding="{Binding NextRecordingDisplay, Mode=OneWay}" Width="150" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Frequency" Binding="{Binding RecurrencePattern, Mode=OneWay}" Width="120" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Match Mode" Binding="{Binding MatchMode}" Width="100" />
                                                    <DataGridCheckBoxColumn Header="New Only" Binding="{Binding OnlyNewEpisodes}" Width="80" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText, Mode=OneWay}" Width="80" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Header="Actions" Width="240">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="Schedule" Background="#0D6EFD" BorderThickness="0" Padding="8,4" Margin="0,0,4,0" FontSize="9" Click="ViewSeriesSchedule_Click" />
                                                                    <Button Content="Edit" Background="#6C757D" BorderThickness="0" Padding="8,4" Margin="0,0,4,0" FontSize="9" Click="EditSeriesRecording_Click" />
                                                                    <Button Content="Delete" Background="#DC3545" BorderThickness="0" Padding="8,4" FontSize="9" Click="DeleteSeriesRecording_Click" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
</UserControl>