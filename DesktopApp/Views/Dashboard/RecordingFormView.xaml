<UserControl x:Class="DesktopApp.Views.Dashboard.RecordingFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                                    <StackPanel>
                                        <!-- Instructions -->
                                        <Border Background="#161B22" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="►" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="How to Schedule a Recording" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Choose how to schedule your recording using the options below. You can either select a program from the TV guide or set custom start/end times." Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9DB2C7" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="#F88166" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Recording Type Selection -->
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="❶" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="Recording Type" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <RadioButton x:Name="EpgRadio" Foreground="#9DB2C7" Margin="0,0,0,12" IsChecked="{Binding IsGuideMode}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="◆" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#28A745" />
                                                        <StackPanel>
                                                            <TextBlock Text="From TV Guide (EPG)" FontWeight="SemiBold" Foreground="#DDE6F2" />
                                                            <TextBlock Text="Select a show from the program guide" FontSize="11" Foreground="#9DB2C7" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="CustomRadio" IsChecked="{Binding IsCustomMode}" Foreground="#9DB2C7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="◇" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FFC107" />
                                                        <StackPanel>
                                                            <TextBlock Text="Custom Time Range" FontWeight="SemiBold" Foreground="#DDE6F2" />
                                                            <TextBlock Text="Set your own start and end times" FontSize="11" Foreground="#9DB2C7" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recording Options -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- EPG-based Recording Panel -->
                                            <Border x:Name="EpgPanel" IsEnabled="{Binding IsGuideMode}" Grid.Column="0" Style="{StaticResource CardStyle}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="❷" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                        <TextBlock Text="Select from TV Guide" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock Text="1. Choose a channel:" Foreground="#9DB2C7" Margin="0,0,0,8" />
                                                    <ComboBox x:Name="ChannelCombo" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id" />

                                                    <TextBlock Text="2. Pick a show to record:" Foreground="#9DB2C7" Margin="0,0,0,8" />
                                                    <Border Background="#1A2332" BorderBrush="#3B4A5C" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock x:Name="ProgramTimeText" Text="{Binding ProgramTimeText}" Foreground="#9DB2C7" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding GuideStatus}" Foreground="#9DB2C7" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                    <Button Content="Refresh Guide" Command="{Binding RefreshProgramsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="8,4" />
                                                    <ComboBox x:Name="ProgramCombo" ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" Margin="0,0,0,8">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem">
                                                                <EventSetter Event="MouseEnter" Handler="ProgramComboItem_MouseEnter" />
                                                                <EventSetter Event="MouseLeave" Handler="ProgramComboItem_MouseLeave" />
                                                                <Setter Property="ToolTip">
                                                                    <Setter.Value>
                                                                        <ToolTip>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" Margin="0,0,0,4" />
                                                                                <TextBlock>
                                                                                    <Run Text="📅 " FontSize="12" />
                                                                                    <Run Text="{Binding StartTimeLocal, Mode=OneWay, StringFormat='ddd, MMM dd yyyy'}" FontWeight="SemiBold" />
                                                                                </TextBlock>
                                                                                <TextBlock>
                                                                                    <Run Text="🕐 " FontSize="12" />
                                                                                    <Run Text="{Binding TimeRangeLocal, Mode=OneWay}" FontWeight="SemiBold" />
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>

                                            <!-- Custom Time Recording Panel -->
                                            <Border x:Name="CustomPanel" Grid.Column="2" Style="{StaticResource CardStyle}" IsEnabled="{Binding IsCustomMode}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="❷" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                        <TextBlock Text="Set Custom Times" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1. Channel:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CustomChannelCombo" ItemsSource="{Binding Channels}" SelectedItem="{Binding CustomChannel}" Margin="0,0,0,8" DisplayMemberPath="Name" SelectedValuePath="Id" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Date:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="StartDatePicker" SelectedDate="{Binding StartDate}" Margin="0,0,0,8" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Start:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                                            <TextBox x:Name="StartTimeBox" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Format: HH:mm (e.g., 20:00 for 8:00 PM)" />
                                                            <TextBlock Text="Format: HH:mm (20:00)" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=StartTimeBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="4. End:" Foreground="#9DB2C7" Margin="0,0,12,0" />
                                                        <Grid Grid.Row="3" Grid.Column="1">
                                                            <TextBox x:Name="EndTimeBox" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Format: HH:mm (e.g., 21:00 for 9:00 PM)" />
                                                            <TextBlock Text="Format: HH:mm (21:00)" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=EndTimeBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Recording Details -->
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="❸" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#347DFF" />
                                                    <TextBlock Text="Recording Settings" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                    <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                                        <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="Recording title" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pre-buffer (min):" Foreground="#9DB2C7" Margin="0,0,12,8" ToolTip="Minutes to start recording before the scheduled time" />
                                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,12,8">
                                                        <TextBox x:Name="PreBufferBox" Text="{Binding PreBuffer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Start recording this many minutes early" />
                                                        <TextBlock Text="2" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PreBufferBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Post-buffer (min):" Foreground="#9DB2C7" Margin="0,0,12,8" ToolTip="Minutes to continue recording after the scheduled end time" />
                                                    <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                                                        <TextBox x:Name="PostBufferBox" Text="{Binding PostBuffer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Continue recording this many minutes past the end time" />
                                                        <TextBlock Text="5" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=PostBufferBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Output File:" Foreground="#9DB2C7" Margin="0,0,12,8" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="OutputFileBox" Text="{Binding OutputFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,0,12,8" />
                                                    <Button Grid.Row="2" Grid.Column="3" Content="Browse..." Background="#347DFF" Foreground="White" BorderThickness="0" Margin="0,0,0,8" Command="{Binding BrowseOutputCommand}" />

                                                    <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Content="Schedule Recording" Background="#28A745" Foreground="White" BorderThickness="0" Padding="24,12" Margin="0,16,0,0" HorizontalAlignment="Center" x:Name="ScheduleButton" Command="{Binding ScheduleCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
</UserControl>