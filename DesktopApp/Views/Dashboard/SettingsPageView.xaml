<UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopApp.Views.Dashboard.SettingsPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SettingsFieldStatusStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8BA1B9" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="2,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="#22863A" /></DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="#F8C555" /></DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="#F88166" /></DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Margin="16,16,16,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Settings" Style="{StaticResource HeaderTextStyle}" />

                        <!-- Status bar -->
                        <Border Background="#1A242F" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <TextBlock x:Name="SettingsStatusText" Text="{Binding StatusMessage}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8BA1B9" /><Style.Triggers><DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="#F88166" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Border>

                        <!-- Player Settings Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🎬 Player Settings" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="External Player" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <ComboBox x:Name="SettingsPlayerKindCombo" ItemsSource="{Binding Players}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding PreferredPlayer}" Background="#21262D" BorderBrush="#30363D" Foreground="#FFDDE6F2" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Player Executable Path" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsPlayerExeTextBox" Text="{Binding PlayerPath, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="C:\Program Files\VideoLAN\VLC\vlc.exe" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsPlayerExeTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <Button Content="Browse" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding BrowsePlayerCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                        <Button x:Name="SettingsAutoDetectPlayerBtn" Content="Auto-detect" Width="110" Height="32" Command="{Binding AutoDetectPlayerCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsPlayerPathStatus" DataContext="{Binding PlayerPathStatus}" Text="{Binding Message}" Style="{StaticResource SettingsFieldStatusStyle}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Arguments Template" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsArgsTemplateTextBox" Text="{Binding PlayerArguments, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="{}{url} --meta-title {title}" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsArgsTemplateTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="Tokens: {url} {title}. Leave blank to use default for selected player." Foreground="#657A91" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="SettingsTestPlayerBtn" Content="Test Player" Width="100" Height="28" Command="{Binding TestPlayerCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                        <TextBlock x:Name="SettingsTestPlayerStatus" DataContext="{Binding TestPlayerStatus}" Text="{Binding Message}" Style="{StaticResource SettingsFieldStatusStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recording Settings Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🎥 Recording Settings" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="FFmpeg Path" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsFfmpegPathTextBox" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="ffmpeg.exe or full path" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsFfmpegPathTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                        <Button Content="Browse" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding BrowseFfmpegCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                        <Button x:Name="SettingsAutoDetectFfmpegBtn" Content="Auto-detect" Width="110" Height="32" Margin="0,0,8,0" Command="{Binding AutoDetectFfmpegCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                        <Button x:Name="SettingsDownloadFfmpegBtn" Content="Download FFmpeg" Width="135" Height="32" Command="{Binding DownloadFfmpegCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsFfmpegPathStatus" DataContext="{Binding FfmpegPathStatus}" Text="{Binding Message}" Style="{StaticResource SettingsFieldStatusStyle}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Recording Directory" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsRecordingDirTextBox" Text="{Binding RecordingDirectory, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="C:\Users\Username\Videos" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsRecordingDirTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Content="Browse" Width="110" Height="32" Margin="0,4,0,8" Command="{Binding BrowseRecordingDirectoryCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    <TextBlock x:Name="SettingsRecordingDirStatus" DataContext="{Binding RecordingDirectoryStatus}" Text="{Binding Message}" Style="{StaticResource SettingsFieldStatusStyle}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="FFmpeg Args Template" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsFfmpegArgsTextBox" Text="{Binding FfmpegArguments, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="{}-i {url} -c copy {output}" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsFfmpegArgsTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="Tokens: {url} {output} {title}. Default copies stream without re-encoding." Foreground="#657A91" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- EPG Settings Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📺 EPG Settings" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Last EPG Update" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <TextBox x:Name="SettingsLastEpgUpdateTextBox" Text="{Binding LastEpgUpdate, Mode=OneWay}" Height="34" IsReadOnly="True" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="EPG Refresh Interval (minutes)" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                    <Grid>
                                        <TextBox x:Name="SettingsEpgIntervalTextBox" Text="{Binding EpgIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="#21262D" Foreground="#FFDDE6F2" BorderBrush="#30363D" Padding="8" />
                                        <TextBlock Text="60" IsHitTestVisible="False" Foreground="#667788" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsEpgIntervalTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Content="Update EPG Now" Width="150" Height="32" Margin="0,4,0,8" Command="{Binding UpdateEpgNowCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    <TextBlock x:Name="SettingsEpgIntervalStatus" DataContext="{Binding EpgIntervalStatus}" Text="{Binding Message}" Style="{StaticResource SettingsFieldStatusStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cache Settings Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="💾 Cache Settings" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="SettingsCachingEnabledCheckBox" IsChecked="{Binding CachingEnabled}" Content="Enable Disk Caching" Foreground="#8BA1B9" FontSize="14" Margin="0,0,0,8">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border x:Name="CheckBoxBorder" Width="18" Height="18" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <Path x:Name="CheckMark" Visibility="Collapsed" Data="M 2 6 L 6 10 L 14 2" Stroke="#22863A" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0D1117" />
                                                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#22863A" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#58A6FF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <TextBlock Text="Save EPG data, VOD content, and images to disk for faster loading between sessions. In-memory caching during the current session is always enabled for optimal performance." Foreground="#657A91" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Button x:Name="SettingsClearCacheButton" Width="120" Height="28" Margin="0,0,8,0" Command="{Binding ClearCacheCommand}" Background="#DC3545" Foreground="White" Padding="8,4">
    <Button.Style>
        <Style TargetType="Button">
            <Setter Property="Content" Value="Clear All Cache" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClearingCache}" Value="True"><Setter Property="Content" Value="Clearing..." /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Button.Style>
</Button>
                                        <Button Content="Cache Inspector" Width="120" Height="28" Click="SettingsCacheInspector_Click" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Data Storage Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="📂 Data Storage" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Credentials Folder" Foreground="#8BA1B9" FontSize="13" Margin="0,0,0,8" />
                                    <TextBox x:Name="SettingsCredentialsFolderTextBox" Text="{Binding CredentialsFolder, Mode=OneWay}" IsReadOnly="True" Background="#161B22" Foreground="#C9D1D9" BorderBrush="#30363D" Padding="8,6" Height="32" Margin="0,0,0,8" />
                                    <Button Content="Open Folder" Width="120" Height="28" Margin="0,0,0,8" Command="{Binding OpenCredentialsFolderCommand}" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    <TextBlock Text="Stored credentials are encrypted using Windows DPAPI for security." Foreground="#657A91" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Favorites Management Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⭐ Favorites Management" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Export and import your favorite channels across different devices or accounts." Foreground="#8BA1B9" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="📤 Export Favorites" Width="150" Height="32" Margin="0,0,8,0" Click="ExportFavorites_Click" Background="#238636" Foreground="White" Padding="8,4" ToolTip="Export your favorites to a JSON file" />
                                        <Button Content="📥 Import Favorites" Width="150" Height="32" Click="ImportFavorites_Click" Background="#1F6FEB" Foreground="White" Padding="8,4" ToolTip="Import favorites from a JSON file" />
                                    </StackPanel>

                                    <TextBlock Text="Favorites are stored per account/playlist. Exported files contain channel information and can be shared between sessions." Foreground="#657A91" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Fixed Bottom Action Bar -->
                <Border Grid.Row="1" Background="#131C27" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restore Defaults" Width="140" Height="40" Margin="0,0,12,0" Command="{Binding RestoreDefaultsCommand}" Background="#DC3545" Foreground="White" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" />
                        <Button Content="Save Settings" Width="120" Height="40" Command="{Binding SaveCommand}" Background="#28A745" Foreground="White" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Grid>
</UserControl>