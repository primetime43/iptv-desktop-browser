<UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DesktopApp.Views.Dashboard.LiveTvPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,0">
                    <TextBlock Text="Live TV" Style="{StaticResource HeaderTextStyle}" />
                    <ComboBox x:Name="CategoryCombo" Width="200" Height="32" Margin="32,0,16,0" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding LiveTv.CategoriesView}" Tag="Select category..." SelectedItem="{Binding LiveTv.SelectedCategory, Mode=TwoWay}" Background="#21262D" BorderBrush="#30363D" />

                    <!-- View Mode Toggle Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Border Background="#161B22" CornerRadius="4" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ChannelsGridViewBtn" Content="⊞" Width="32" Height="32" Margin="0,0,2,0" ToolTip="Grid View" Click="ChannelsGridView_Click" Background="Transparent" Foreground="#FFDDE6F2" BorderThickness="0" FontSize="14" />
                                <Button x:Name="ChannelsListViewBtn" Content="☰" Width="32" Height="32" ToolTip="List View" Click="ChannelsListView_Click" Background="Transparent" Foreground="#FFDDE6F2" BorderThickness="0" FontSize="14" />
                            </StackPanel>
                        </Border>

                        <!-- Tile Size Selector -->
                        <ComboBox x:Name="TileSizeCombo" Width="80" Height="32" Margin="8,0,0,0" SelectionChanged="TileSize_SelectionChanged" Background="#21262D" BorderBrush="#30363D" Foreground="#FFDDE6F2">
                            <ComboBoxItem Content="S" Tag="Small" />
                            <ComboBoxItem Content="M" Tag="Medium" />
                            <ComboBoxItem Content="L" Tag="Large" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="16,8,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LiveTv.ChannelsCountText}" Foreground="#9DB2C7" VerticalAlignment="Center"/>
                        <Button Content="Retry loading" Command="{Binding LiveTv.RetryCommand}" Visibility="{Binding LiveTv.HasError, Converter={StaticResource BoolToVisibilityConverter}}" Margin="12,0,0,0" Padding="8,4"/>
                        <TextBlock Text="Loading categories…" Foreground="#9DB2C7" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding LiveTv.IsLoadingCategories, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LiveTv.CategoriesError}" Foreground="#F88166" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LiveTv.ErrorMessage}" Foreground="#F88166" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Content Area -->
                <Grid Grid.Row="2" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Main Content Area -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <!-- Channels Grid View -->
                        <ItemsControl x:Name="ChannelsGridView" Visibility="Visible" Style="{StaticResource ChannelGridCatalogStyle}" ItemsSource="{Binding LiveTv.ChannelsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" PreviewMouseLeftButtonDown="ChannelTile_PreviewMouseLeftButtonDown" MouseEnter="ChannelTile_MouseEnter" Cursor="Hand">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="RecordingButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                            <DoubleAnimation Storyboard.TargetName="FavoriteButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="RecordingButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                            <DoubleAnimation Storyboard.TargetName="FavoriteButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Channel Number Badge -->
                                                <Border Grid.Row="0" Background="#347DFF" CornerRadius="0,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,2" MinWidth="24">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource NewChannelBadge}" Margin="5,0,0,0">
                                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Channel Logo/Name -->
                                                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                                    <Image Source="{Binding LogoImage}" Width="48" Height="48" Margin="0,0,0,8" Stretch="Uniform" />
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFDDE6F2" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" />
                                                </StackPanel>

                                                <!-- Now Playing -->
                                                <TextBlock Grid.Row="1" Text="{Binding NowTitle}" FontSize="11" Foreground="#9DB2C7" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />

                                                <!-- Recording Indicator -->
                                                <Border x:Name="RecordingIndicator" Grid.Row="0" Background="#DC3545" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Ellipse Width="8" Height="8" Fill="White" />
                                                </Border>

                                                <!-- Favorite Button (appears on hover) -->
                                                <Button x:Name="FavoriteButton" Grid.Row="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" BorderThickness="0" Click="ChannelFavoriteButton_Click" Opacity="0" Cursor="Hand">
                                                    <TextBlock FontSize="14" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="☆" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Text" Value="⭐" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                                        <Setter Property="Foreground" Value="Black" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#FFD700" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Width="32" Height="32">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                                    <Setter Property="ToolTip" Value="Remove from Favorites" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                                    <Setter Property="ToolTip" Value="Add to Favorites" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Recording Button (appears on hover) -->
                                                <Button x:Name="RecordingButton" Grid.Row="0" Background="#28A745" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" BorderThickness="0" Click="ChannelRecordButton_Click" Opacity="0" Cursor="Hand" ToolTip="Start/Stop Recording">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⏺️" FontSize="14" Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="⏺️" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                            <Setter Property="Text" Value="⏹️" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Width="32" Height="32">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Background" Value="#DC3545" />
                                                                    <Setter Property="ToolTip" Value="Stop Recording" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                                                    <Setter Property="Background" Value="#28A745" />
                                                                    <Setter Property="ToolTip" Value="Start Recording" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <!-- Channels List View -->
                        <ItemsControl x:Name="ChannelsListView" Visibility="Collapsed" Style="{StaticResource CatalogListStyle}" ItemsSource="{Binding LiveTv.ChannelsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12" PreviewMouseLeftButtonDown="ChannelTile_PreviewMouseLeftButtonDown" MouseEnter="ChannelTile_MouseEnter" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Channel Number -->
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="14" FontWeight="Bold" Foreground="#8BA1B9" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- Channel Logo -->
                                                <Border Grid.Column="1" Width="48" Height="32" Background="#223247" CornerRadius="4">
                                                    <Grid>
                                                        <Image Source="{Binding LogoImage}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <!-- Channel Info -->
                                                <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Style="{StaticResource NewChannelBadge}" Margin="6,0,0,0">
                                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#FFDDE6F2" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding NowTitle}" FontSize="12" Foreground="#8BA1B9" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding NowTimeRange}" FontSize="11" Foreground="#6F7882" />
                                                </StackPanel>

                                                <!-- Recording Status -->
                                                <Border Grid.Column="3" Background="#DC3545" CornerRadius="12" Padding="8,2" Margin="0,0,8,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="REC" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>

                                                <!-- Favorite Button -->
                                                <Button Grid.Column="4" Width="32" Height="24" FontSize="12" Margin="0,0,4,0" Click="ChannelFavoriteButton_Click" Opacity="0.7" Foreground="White" BorderThickness="0">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="☆" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Text" Value="⭐" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                                        <Setter Property="Foreground" Value="Black" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#FFD700" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                                    <Setter Property="ToolTip" Value="Remove from Favorites" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="False">
                                                                    <Setter Property="ToolTip" Value="Add to Favorites" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Recording Button -->
                                                <Button Grid.Column="5" Width="32" Height="24" Content="●" FontSize="12" Click="ChannelRecordButton_Click" Opacity="0.7" Background="#28A745" Foreground="White" BorderThickness="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                    <Setter Property="Background" Value="#DC3545" />
                                                                    <Setter Property="ToolTip" Value="Stop Recording" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                                                    <Setter Property="Background" Value="#28A745" />
                                                                    <Setter Property="ToolTip" Value="Start Recording" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <!-- Channels Loading Overlay -->
                        <Grid x:Name="ChannelsLoadingOverlay" Style="{StaticResource LoadingOverlayStyle}" Visibility="{Binding LiveTv.IsLoadingChannels, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="40" Height="40">
                                    <Ellipse Width="32" Height="32" Stroke="#347DFF" StrokeThickness="3" StrokeDashArray="50.26" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="Loading channels..." Style="{StaticResource LoadingTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Channel Info Panel -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Search Controls -->
                                <TextBlock Text="Search" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,8" />
                                <Border Background="#182433" CornerRadius="6" BorderBrush="#223247" BorderThickness="1" Padding="8" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <TextBox x:Name="ChannelSearchBox" Height="32" Margin="0,0,0,4" BorderThickness="0" Background="#0E1620" Foreground="#DDE6F2" Padding="6,4" VerticalContentAlignment="Center" Text="{Binding LiveTv.SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by channel number, name, or program title" />
                                            <TextBlock Text="Search by number or name..." IsHitTestVisible="False" Foreground="#667788" Margin="6,4,0,4" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ChannelSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Search Loading Indicator -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LiveTv.IsSearchLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Ellipse Width="16" Height="16" Stroke="#347DFF" StrokeThickness="2" StrokeDashArray="25.13" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform />
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <TextBlock Text="Searching..." FontSize="10" Foreground="#347DFF" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Content="Search All Channels" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="#DDE6F2" IsChecked="{Binding LiveTv.SearchAllChannels}" ToolTip="Search across all channels" />
                                        <CheckBox x:Name="RecentlyAddedOnlyCheckBox" Content="Recently added only (7 days)" Margin="0,8,0,0" Foreground="#DDE6F2" IsChecked="{Binding LiveTv.ShowRecentlyAddedOnly}"
                                                  ToolTip="Filter the selected category. Enable Search All Channels to check the full catalog, even without search text." />
                                        <TextBlock Text="New uses provider dates, or additions discovered after your first visit." TextWrapping="Wrap" FontSize="11" Foreground="#9DB2C7" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Separator Background="#21262D" Margin="0,0,0,12" />

                                <!-- Channel Info -->
                                <TextBlock Text="Selected Channel:" Foreground="#8BA1B9" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedChannelName}" FontWeight="Bold" Foreground="#F0F6FC" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Content="Play with quality…" Click="ChooseChannelQuality_Click" Padding="12,6" Margin="0,0,0,12">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChannel}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <TextBlock Text="{Binding NowProgramText}" Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />

                                <TextBlock Text="{Binding SelectedChannel.NowTitle}" Foreground="#DDE6F2" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <TextBlock Text="Description:" Margin="0,0,0,4" Foreground="#8BA1B9" />
                                <TextBlock Text="{Binding SelectedChannel.NowDescription}" Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Separator Background="#21262D" Margin="0,0,0,12" />

                                <!-- Upcoming Programs -->
                                <TextBlock Text="Upcoming:" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding LiveTv.UpcomingPrograms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#182433" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeRangeLocal}" FontSize="11" Foreground="#8BA1B9" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#DDE6F2" TextWrapping="Wrap" FontWeight="Bold" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9DB2C7" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
</UserControl>
