<Window x:Class="DesktopApp.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IPTV Dashboard" Height="700" Width="1400" MinHeight="600" MinWidth="1000" Background="#0D1117" WindowStartupLocation="CenterScreen" xmlns:pages="clr-namespace:DesktopApp.Views.Dashboard">

    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/iptv-desktop-browser;component/Views/Dashboard/DashboardResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- App Header -->
                <Border Background="#0D1117" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📺" FontSize="20" Margin="0,0,8,0" />
                        <TextBlock Text="IPTV Dashboard" FontSize="16" FontWeight="Bold" Foreground="#FFDDE6F2" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,16,0,0">
                    <Button x:Name="LiveTvNavButton" Style="{StaticResource NavButtonStyle}" Tag="Selected" Click="NavigateToLiveTv">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📺" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Live TV" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="VodNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToVod">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Video on Demand" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecordingNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToRecording">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏺️" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Recording" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SchedulerNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToScheduler">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Scheduler" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProfileNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToProfile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Profile" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LogsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateToLogs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Logs" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CacheInspectorNavButton" Style="{StaticResource NavButtonStyle}" Click="OpenCacheInspector">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="Cache Inspector" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Section -->
                <StackPanel Margin="16" VerticalAlignment="Bottom">
                    <Separator Background="#21262D" Margin="0,0,0,16" />

                    <!-- Logout Button -->
                    <Button Content="Logout" Style="{StaticResource NavButtonStyle}" Foreground="#DC3545" Click="Logout_Click" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Style="{StaticResource ContentPanelStyle}">
            <!-- Live TV Page -->
            <pages:LiveTvPageView x:Name="LiveTvPage" Visibility="Visible" />

            <!-- Favorites Page (Hidden by default) -->

            <!-- VOD Page (Hidden by default) -->
            <pages:MoviesSeriesPageView x:Name="VodPage" Visibility="Collapsed" />

            <!-- Recording Page (Hidden by default) -->
            <Grid x:Name="RecordingPage" Visibility="Collapsed">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Page Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Recording" Style="{StaticResource HeaderTextStyle}" />
                            <Border Background="#28A745" CornerRadius="12" Padding="8,4" Margin="24,4,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,4,0" />
                                    <TextBlock Text="Ready" FontSize="12" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Quick Start Section -->
                        <Border Background="#161B22" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#30363D" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Quick Record" FontSize="16" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Start recording the currently selected channel instantly with one click." Foreground="#9DB2C7" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Main Recording Section -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <!-- Manual Recording Controls -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="⏺️" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Manual Recording" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Channel Selection -->
                                    <Border Background="#182433" CornerRadius="6" Padding="16" Margin="0,0,0,16" BorderBrush="#223247" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📺 Channel Selection" FontSize="14" FontWeight="SemiBold" Foreground="#DDE6F2" Margin="0,0,0,12" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0">
                                                    <TextBlock Text="Selected Channel:" FontSize="12" Foreground="#9DB2C7" Margin="0,0,0,6" />
                                                    <Border Background="#0E1620" CornerRadius="4" Padding="12,8" BorderBrush="#223247" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="SelectedChannelText" Text="None selected" FontSize="14" Foreground="#FFDDE6F2" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Text="💡 Tip: Select a channel from the Live TV tab to enable recording" FontSize="11" Foreground="#657A91" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Recording Controls -->
                                    <Border Background="#182433" CornerRadius="6" Padding="16" Margin="0,0,0,0" BorderBrush="#223247" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🎬 Recording Controls" FontSize="14" FontWeight="SemiBold" Foreground="#DDE6F2" Margin="0,0,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="Current Status:" FontSize="12" Foreground="#9DB2C7" Margin="0,0,0,6" />
                                                    <Border Background="#0E1620" CornerRadius="4" Padding="12,8" BorderBrush="#223247" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="RecordingPageStatusIndicator" Width="8" Height="8" Fill="#6C757D" Margin="0,0,8,0" />
                                                            <TextBlock x:Name="RecordingStatusDisplay" Text="{Binding RecordingManager.StatusDisplay}" FontSize="14" Foreground="#FFDDE6F2" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Button x:Name="RecordButton" Background="#28A745" Foreground="White" BorderThickness="0" Padding="32,16" FontSize="16" FontWeight="SemiBold" Click="RecordBtn_Click" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="RecordBtnIcon" Text="⏺️" FontSize="16" Margin="0,0,8,0" />
                                                            <TextBlock x:Name="RecordBtnText" Text="Start Recording" />
                                                        </StackPanel>
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#28A745" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#218838" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Recording Information Panel -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Recording Info" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Current Recording Status -->
                                        <Border Background="#182433" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="#223247" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="📊" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Current Recording" FontSize="12" FontWeight="SemiBold" Foreground="#DDE6F2" VerticalAlignment="Center" />
                                                    <Border x:Name="RecordingStatusBadge" Margin="8,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,2" Background="#394150">
                                                        <TextBlock x:Name="RecordingStatusBadgeText" Text="Idle" Foreground="White" FontWeight="SemiBold" FontSize="10" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel x:Name="RecordingDetailsPanel" Visibility="Collapsed">
                                                    <TextBlock Text="Channel:" Foreground="#9DB2C7" FontSize="10" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="RecordingChannelText" Text="None" Foreground="#DDE6F2" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6" />

                                                    <TextBlock Text="Started:" Foreground="#9DB2C7" FontSize="10" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="RecordingStartedText" Text="--" Foreground="#DDE6F2" FontSize="11" Margin="0,0,0,6" />

                                                    <TextBlock Text="File:" Foreground="#9DB2C7" FontSize="10" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="RecordingFileText" Text="--" Foreground="#DDE6F2" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="RecordingPathText" Text="--" Foreground="#60758C" FontFamily="Consolas" FontSize="8" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Duration" Foreground="#9DB2C7" FontSize="9" />
                                                            <TextBlock x:Name="RecordingDurationText" Text="00:00:00" Foreground="#DDE6F2" FontWeight="Bold" FontSize="12" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Size" Foreground="#9DB2C7" FontSize="9" />
                                                            <TextBlock x:Name="RecordingSizeText" Text="0 MB" Foreground="#DDE6F2" FontWeight="Bold" FontSize="12" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Bitrate" Foreground="#9DB2C7" FontSize="9" />
                                                            <TextBlock x:Name="RecordingBitrateText" Text="-- kbps" Foreground="#DDE6F2" FontWeight="Bold" FontSize="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel x:Name="RecordingIdlePanel" Visibility="Visible">
                                                    <TextBlock Text="No active recording" Foreground="#9DB2C7" FontSize="11" TextAlignment="Center" Margin="0,16,0,16" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recording Settings Quick Access -->
                                        <Border Background="#182433" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="#223247" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ Quick Settings" FontSize="12" FontWeight="SemiBold" Foreground="#DDE6F2" Margin="0,0,0,8" />

                                                <StackPanel>
                                                    <TextBlock Text="Output Directory:" FontSize="10" Foreground="#9DB2C7" Margin="0,0,0,2" />
                                                    <TextBlock x:Name="RecordingOutputDirectoryText" Text="C:\Users\Videos" FontSize="10" Foreground="#DDE6F2" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                                    <TextBlock Text="FFmpeg Status:" FontSize="10" Foreground="#9DB2C7" Margin="0,0,0,2" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Ellipse Width="6" Height="6" Fill="#28A745" Margin="0,0,4,0" />
                                                        <TextBlock Text="Ready" FontSize="10" Foreground="#DDE6F2" />
                                                    </StackPanel>

                                                    <Button Content="Open Settings" Background="#347DFF" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="10" Margin="0,4,0,0" Click="NavigateToSettings" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Help & Tips -->
                                        <Border Background="#161B22" CornerRadius="6" Padding="12" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="💡 Tips" FontSize="12" FontWeight="SemiBold" Foreground="#DDE6F2" Margin="0,0,0,8" />

                                                <StackPanel>
                                                    <TextBlock Text="• Select a channel from Live TV to enable recording" FontSize="10" Foreground="#9DB2C7" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                    <TextBlock Text="• Use the Scheduler for advanced recording options" FontSize="10" Foreground="#9DB2C7" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                    <TextBlock Text="• Check Settings to configure output directory" FontSize="10" Foreground="#9DB2C7" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                    <TextBlock Text="• Recordings are saved in MP4/TS format" FontSize="10" Foreground="#9DB2C7" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Advanced Options -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🔧" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Advanced Options" FontSize="16" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Background="#347DFF" Foreground="White" BorderThickness="0" Padding="16,12" Margin="0,0,8,0" Click="NavigateToScheduler">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Schedule Recording" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Background="#6C757D" Foreground="White" BorderThickness="0" Padding="16,12" Margin="8,0,0,0" Click="OpenRecordingFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Open Output Folder" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Scheduler Page (Hidden by default) -->
            <pages:SchedulerPageView x:Name="SchedulerPage" Visibility="Collapsed" />

            <!-- Profile Page (Hidden by default) -->
            <Grid x:Name="ProfilePage" Visibility="Collapsed">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Profile" Style="{StaticResource HeaderTextStyle}" />

                        <!-- Account Information -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Account Information" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Username:" Foreground="#8BA1B9" Grid.Row="0" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileUsername}" Foreground="#DDE6F2" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Status:" Foreground="#8BA1B9" Grid.Row="1" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileStatus}" Foreground="#DDE6F2" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Trial Account:" Foreground="#8BA1B9" Grid.Row="2" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileTrialText}" Foreground="#DDE6F2" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Expires:" Foreground="#8BA1B9" Grid.Row="3" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileExpiryText}" Foreground="#DDE6F2" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Days Remaining:" Foreground="#8BA1B9" Grid.Row="4" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileDaysRemaining}" Foreground="#DDE6F2" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Max Connections:" Foreground="#8BA1B9" Grid.Row="5" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding ProfileMaxConnections}" Foreground="#DDE6F2" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

                                    <TextBlock Text="Active Connections:" Foreground="#8BA1B9" Grid.Row="6" />
                                    <TextBlock Text="{Binding ProfileActiveConnections}" Foreground="#DDE6F2" Grid.Row="6" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>


                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Settings Page -->
            <pages:SettingsPageView x:Name="SettingsPage" DataContext="{Binding SettingsPageModel}" CacheInspectorRequested="OpenCacheInspector" ExportFavoritesRequested="ExportFavorites_Click" ImportFavoritesRequested="ImportFavorites_Click" Visibility="Collapsed" />

            <!-- Logs Page -->
            <Grid x:Name="LogsPage" Visibility="Collapsed">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Logs" Style="{StaticResource HeaderTextStyle}" />

                        <!-- Status bar -->
                        <Border Background="#1A242F" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <TextBlock x:Name="LogsStatusText" Text="View and manage application logs and diagnostic information" Foreground="#8BA1B9" FontSize="12" />
                        </Border>

                        <!-- Raw Output Log Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="📝 Raw Output Log" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                    <CheckBox x:Name="SettingsEnableLoggingCheckBox" Content="Enable Logging" Foreground="#9DB2C7" Margin="16,0,0,0" IsChecked="True" Checked="SettingsEnableLogging_Changed" Unchecked="SettingsEnableLogging_Changed" />
                                </StackPanel>

                                <TextBlock Text="Shows API calls, channel loading, and other diagnostic information in real-time." Foreground="#8BA1B9" FontSize="12" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Clear Log" Width="100" Height="28" Margin="0,0,8,0" Click="SettingsClearLog_Click" Background="#6C757D" Foreground="White" Padding="8,4" />
                                    <Button Content="Copy Log" Width="100" Height="28" Margin="0,0,8,0" Click="SettingsCopyLog_Click" Background="#347DFF" Foreground="White" Padding="8,4" />
                                    <Button Content="Save Log" Width="100" Height="28" Click="SettingsSaveLog_Click" Background="#28A745" Foreground="White" Padding="8,4" />
                                </StackPanel>

                                <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Height="300">
                                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8">
                                        <TextBlock x:Name="RawOutputLogTextBlock" Text="Raw output log will appear here when logging is enabled..." Foreground="#8BA1B9" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Toast Notification Container -->
        <Border x:Name="ToastContainer" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,24" MaxWidth="400" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="16,12" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" Opacity="0.5" BlurRadius="12" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon/Color Bar -->
                <Border x:Name="ToastColorBar" Grid.Column="0" Width="4" CornerRadius="2" Background="#28A745" Margin="0,0,12,0" />

                <!-- Content -->
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ToastTitle" Text="Notification" FontWeight="SemiBold" FontSize="14" Foreground="#DDE6F2" TextWrapping="Wrap" />
                    <TextBlock x:Name="ToastMessage" Text="Message" FontSize="12" Margin="0,4,0,0" Foreground="#9DB2C7" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
