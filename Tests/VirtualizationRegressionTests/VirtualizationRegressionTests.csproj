<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../DesktopApp/DesktopApp.csproj" />
    <None Include="../../DesktopApp/Views/DashboardWindow.xaml" Link="DashboardWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../DesktopApp/Views/Dashboard/*.xaml" Link="Dashboard/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
